rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /captains/{uid} {
      function signedIn() { return request.auth != null; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','bosses','survey','score'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.bosses is int && d.bosses >= 0 && d.bosses <= 5
          && d.survey is int && d.survey >= 0 && d.survey <= 999999
          && d.score == d.bosses * 1000000 + d.survey;
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if signedIn() && request.auth.uid == uid && valid();
      allow update: if signedIn() && request.auth.uid == uid && valid()
        && request.resource.data.score >= resource.data.score;
    }
  }
}
