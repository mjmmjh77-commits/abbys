{
  "name": "abyss-fishing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ranking": "pnpm dlx firebase-tools@13.35.1 emulators:start --project demo-abyss --only auth,firestore --import=.ranking-data --export-on-exit=.ranking-data",
    "test:browser": "node --experimental-strip-types tests/browser.mjs",
    "test:menus": "node --experimental-strip-types tests/menus.mjs",
    "build:showcase": "tsc --noEmit && vite build --mode showcase",
    "test:trail": "node --experimental-strip-types tests/trail-browser.mjs",
    "test:coral": "node --experimental-strip-types tests/coral-browser.mjs"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
